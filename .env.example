# Beads Station — environment template.
# Copy to .env and fill in real values. The real .env is gitignored.
#
# The Tauri shell loads these at app startup and passes them to the
# claude CLI subprocess. The claude CLI honors both variables natively:
# ANTHROPIC_BASE_URL redirects api.anthropic.com to a different origin
# (e.g. a corporate LLM gateway), and ANTHROPIC_API_KEY is forwarded
# in the Authorization header.

ANTHROPIC_API_KEY=sk-ant-or-gateway-token-here
ANTHROPIC_BASE_URL=http://localhost:6655

# Optional gateway spend meter (only with BS_AUTH_PROFILE=gateway).
# BS_GATEWAY_SPEND_URL=https://gateway.example.com
# BS_GATEWAY_SPEND_TOKEN_FILE=~/.config/gateway/spend-token.json
